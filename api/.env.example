# ── Serveur ──────────────────────────────
PORT=3000
NODE_ENV=development

# ── MongoDB ──────────────────────────────
MONGO_URI=mongodb://localhost:27017/mailguard

# ── Redis ────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379

# ── ML Service ───────────────────────────
ML_SERVICE_URL=http://localhost:5000

# ── Cache ────────────────────────────────
CACHE_TTL_SECONDS=3600

# ── Blacklist GitHub ─────────────────────
BLACKLIST_UPDATE_CRON=0 0 * * 0
BLACKLIST_GITHUB_URL=https://raw.githubusercontent.com/disposable-email-domains/disposable-email-domains/master/disposable_email_blocklist.conf
