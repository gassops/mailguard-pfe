      "type": "stat",
      "datasource": "Prometheus",
      "gridPos": {
        "h": 4,
        "w": 5,
        "x": 15,
        "y": 0
      },
      "targets": [
        {
          "expr": "100 * (sum(increase(http_requests_total{job=\"mailguard-api\",route=\"/verify\",status=~\"5..\"}[$__range])) or vector(0)) / sum(increase(http_requests_total{job=\"mailguard-api\",route=\"/verify\"}[$__range]))",
          "instant": true,
          "legendFormat": "valeur"
        }
      ],
      "fieldConfig": {
