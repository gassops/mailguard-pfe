    {
      "id": 5,
      "title": "SLO 4 — Cache hit ratio (> 60 %)",
      "type": "stat",
      "datasource": "Prometheus",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 20,
        "y": 0
      },
      "targets": [
        {
          "expr": "((100 * sum(increase(mailguard_cache_hits_total[$__range])) / (sum(increase(mailguard_cache_hits_total[$__range])) + sum(increase(mailguard_cache_misses_total[$__range])))) and on() (vector(${slo_cache}) == 1)) or on() (vector(-1) and on() (vector(${slo_cache}) == 0))",
          "instant": true,
          "legendFormat": "valeur"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "mappings": [
            {
              "type": "range",
              "options": {
                "from": -1.5,
                "to": -0.5,
                "result": {
                  "text": "non évalué (adresses inédites)",
                  "color": "blue",
                  "index": 0
                }
              }
            }
          ],
          "decimals": 1,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 60
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
